{% assign repo_url = include.repository | split: '/' %}
{% if site.data.repositories.github_users contains repo_url.first %}
  {% assign show_owner = false %}
{% else %}
  {% assign show_owner = true %}
{% endif %}

<div class="repo p-2 text-center hoverable">
  <a href="https://github.com/{{ include.repository }}">
    <img
      class="w-100"
      alt="{{ include.repository }}"
      src="https://github-stats-extended.vercel.app/api/pin/?username={{ repo_url[0] }}&repo={{ repo_url[1] }}&bg_color={{ site.repo_bg_color }}&title_color={{ site.repo_title_color }}&text_color={{ site.repo_text_color }}&icon_color={{ site.repo_icon_color }}&hide_border=true&show_owner={{ show_owner }}"
    >
  </a>
</div>
