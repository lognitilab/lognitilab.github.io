<div class="repo p-2 text-center hoverable">
  <a href="https://github.com/{{ include.username }}">
    <img
      class="w-100"
      alt="{{ include.username }}"
      src="https://github-stats-extended.vercel.app/api/?username={{ include.username }}&bg_color={{ site.repo_bg_color }}&title_color={{ site.repo_title_color }}&text_color={{ site.repo_text_color }}&icon_color={{ site.repo_icon_color }}&hide_border=true&show_icons=true"
    >
  </a>
</div>
