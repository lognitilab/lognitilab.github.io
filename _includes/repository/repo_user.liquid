<div class="repo p-2 text-center hoverable">
  <a href="https://github.com/{{ include.username }}">
    <img
      class="w-100"
      alt="{{ include.username }}"
      src="https://github-stats-extended.vercel.app/api/?username={{ include.username }}&theme={{ site.repo_theme }}&show_icons=true"
    >
  </a>
</div>
