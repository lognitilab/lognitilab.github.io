{% assign teachings_by_year = site.teachings | group_by: 'year' | sort: 'name' | reverse %}
<div class="courses">
  {% for year_group in teachings_by_year %}
    <h2 class="year">{{ year_group.name }}</h2>
    <div class="course-list">
      {% assign courses = year_group.items | sort: 'title' %}
      {% for course in courses %}
        <a href="{{ course.url | relative_url }}">
          <div class="course-item hoverable">
            <h3 class="course-title">{{ course.title }}</h3>
            <div class="course-meta">
              <span class="course-term">{{ course.term }}</span>
              <span class="course-instructor">{{ course.instructor }}</span>
            </div>
            <div class="course-description">
              <p>{{ course.description }}</p>
            </div>
          </div>
        </a>
      {% endfor %}
    </div>
  {% endfor %}
</div>
